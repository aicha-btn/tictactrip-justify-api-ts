{
  "name": "tictactrip-justify-api",
  "version": "1.0.0",
  "description": "API REST TypeScript qui justifie du texte sur 80 caracteres avec authentification par token.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "coverage": "npm run build && node --test --experimental-test-coverage dist/test/**/*.test.js",
    "dev": "npm run build -- --watch",
    "lint": "npm run typecheck",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm run test && npm run coverage"
  },
  "keywords": [
    "api",
    "rest",
    "typescript",
    "text-justify",
    "tictactrip"
  ],
  "author": "Aicha",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
